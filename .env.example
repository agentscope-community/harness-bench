# hbench matrix run settings. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env && chmod 600 .env
# Then start: bash deploy/run-matrix.sh            (or: bash deploy/run-matrix.sh path/to/envfile)
# Never commit the filled copy or paste keys into chat.

# ---- Matrix / execution -------------------------------------------------------
HB_MATRIX=configs/matrices/bailian-18.yaml   # 3 datasets x 2 models x 3 harnesses
HB_CLUSTER=docker                            # docker | ack | acs | kubernetes
HB_CONCURRENCY=4                             # total trials running at once, across all 18 combinations
HB_N_TASKS=1                                 # per-dataset cap; 1 = smoke (18 trials). Leave empty for full datasets
HB_RUN_NAME=bailian-18                       # job name prefix; a UTC timestamp is appended
HB_DRY_RUN_ONLY=0                            # 1 = render + dry-run only, no model calls

# ---- Candidate models (Bailian OpenAI-compatible) -----------------------------
HB_BAILIAN_API_KEY=                          # sk-... (secret)
HB_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Recommended alternative: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
HB_MODEL_A_ID=                               # e.g. a model listed for Bailian's Responses API (codex needs /responses)
HB_MODEL_B_ID=                               # must differ from HB_MODEL_A_ID

# ---- tau3 simulated user / NL assertions (OpenAI-compatible, via LiteLLM) -----
# Reusing Bailian is fine. LiteLLM usually needs the provider prefix, e.g. openai/<model-id>.
HB_TAU_API_KEY="${HB_BAILIAN_API_KEY}"
HB_TAU_BASE_URL="${HB_BAILIAN_BASE_URL}"
HB_TAU_USER_MODEL=                           # e.g. openai/<model-id>; keep fixed across comparisons
HB_TAU_ASSERTIONS_MODEL=                     # e.g. openai/<model-id>

# ---- Package index for SWE-bench verifiers (optional) -------------------------
HB_PIP_INDEX_URL=https://pypi.org/simple     # e.g. https://mirrors.aliyun.com/pypi/simple/

# ---- Harness runtime image ----------------------------------------------------
# Docker: local tag built by `python -m hbench images build ... --execute`.
# ACK/ACS/Kubernetes: the published registry image reachable from the cluster.
HB_RUNTIME_IMAGE=hbench/harness-runtime:0.1.0

# ---- Kubernetes / ACK / ACS only (ignored for docker) -------------------------
HB_NAMESPACE=harness-bench
HB_KUBECONFIG=                               # empty = default ~/.kube/config
HB_KUBE_CONTEXT=
HB_REGISTRY=                                 # e.g. registry.cn-hangzhou.aliyuncs.com/<ns>
HB_IMAGE_PULL_SECRET=                        # name of an existing Secret, not its content
