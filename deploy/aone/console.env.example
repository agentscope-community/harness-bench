# Console settings for the systemd unit. Installed to /etc/harness-bench/console.env
# with mode 0640 root:hbench. The HB_* block below (appended by install.sh from
# .env.example) is inherited by `hbench run`; credentials must never enter Git.
# 0.0.0.0 = reachable on every interface. The console has no built-in auth:
# restrict the security group / firewall, and put an authenticated proxy in front
# of any public entry point. Use 127.0.0.1 to keep it host-only.
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8090
# 1 allows paid real runs from the web UI. Keep 0 outside production.
CONSOLE_ALLOW_REAL_RUNS=0
# Optional read-only trajectory viewer (harbor view on 127.0.0.1:8091).
#CONSOLE_VIEWER_URL=http://127.0.0.1:8091
